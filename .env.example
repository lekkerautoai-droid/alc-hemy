# PostgreSQL — get a free DB at neon.tech or use Vercel Postgres.
# For local dev, easiest is Docker: docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev -d postgres
# Then: postgres://postgres:dev@localhost:5432/postgres
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Admin login
ADMIN_PASSWORD="changeme"
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# Resend (free tier — sign up at resend.com)
RESEND_API_KEY=""
SITTER_EMAIL="anabel@example.com"

# WhatsApp number in international format with country code (no + or spaces)
NEXT_PUBLIC_SITTER_PHONE="27000000000"
NEXT_PUBLIC_SITTER_NAME="Anabel Brink"
NEXT_PUBLIC_SERVICE_AREA="Cape Town CBD"
